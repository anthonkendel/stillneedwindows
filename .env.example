# Required. Free key from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Public address of the site, used for canonical URLs, social previews, robots.txt
# and the sitemap. Defaults to https://stillneedwindows.com.
VITE_SITE_URL=https://stillneedwindows.com

# Optional. Upstash Redis for caching ProtonDB lookups across requests.
# Without these, an in-memory cache is used (fine for local dev).
# The Vercel Marketplace Upstash integration sets either pair automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
