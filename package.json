{
  "name": "stillneedwindows",
  "version": "0.1.0",
  "private": true,
  "description": "Does your Steam library still need Windows? Check how much of it runs on Linux: every game rated with ProtonDB tiers, Steam Deck status and anti-cheat blockers.",
  "keywords": [
    "steam",
    "linux",
    "protondb",
    "proton",
    "linux-gaming",
    "steam-deck",
    "anti-cheat",
    "vue",
    "hono",
    "vercel"
  ],
  "homepage": "https://stillneedwindows.vercel.app",
  "bugs": {
    "url": "https://github.com/anthonkendel/stillneedwindows/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthonkendel/stillneedwindows.git"
  },
  "license": "MIT",
  "author": "anthonkendel (https://github.com/anthonkendel)",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch server/dev.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@upstash/redis": "^1.39.0",
    "hono": "^4.13.13",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
